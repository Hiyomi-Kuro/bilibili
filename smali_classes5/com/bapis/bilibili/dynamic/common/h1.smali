    d1 = {
        "\u0000l\n\u0002\u0018\u0002\n\u0002\u0010\u0000\n\u0000\n\u0002\u0018\u0002\n\u0000\n\u0002\u0018\u0002\n\u0000\n\u0002\u0018\u0002\n\u0002\u0008\u0003\n\u0002\u0010\u0011\n\u0002\u0010\t\n\u0002\u0008\u0002\n\u0002\u0018\u0002\n\u0002\u0008\u0002\n\u0002\u0010\u000e\n\u0000\n\u0002\u0010 \n\u0000\n\u0002\u0010\u0008\n\u0002\u0008\u000e\n\u0002\u0018\u0002\n\u0002\u0008\u0007\n\u0002\u0018\u0002\n\u0000\n\u0002\u0010\u000b\n\u0002\u0008\u0007\n\u0002\u0018\u0002\n\u0002\u0008{\n\u0002\u0018\u0002\n\u0002\u0008\u0006\u0008\u0087\u0008\u0018\u0000 \u00b6\u00012\u00020\u0001:\u0004\u00b7\u0001\u00b8\u0001B\u00db\u0002\u0012\u0008\u0008\u0002\u00109\u001a\u00020\u0012\u0012\u000e\u0008\u0002\u0010:\u001a\u0008\u0012\u0004\u0012\u00020\u000c0\u0014\u0012\u0008\u0008\u0002\u0010;\u001a\u00020\u0016\u0012\u0008\u0008\u0002\u0010<\u001a\u00020\u0016\u0012\u0008\u0008\u0002\u0010=\u001a\u00020\u0016\u0012\u0008\u0008\u0002\u0010>\u001a\u00020\u0016\u0012\u0008\u0008\u0002\u0010?\u001a\u00020\u0012\u0012\u0008\u0008\u0002\u0010@\u001a\u00020\u0012\u0012\u0008\u0008\u0002\u0010A\u001a\u00020\u0012\u0012\u0008\u0008\u0002\u0010B\u001a\u00020\u000c\u0012\u0008\u0008\u0002\u0010C\u001a\u00020\u0012\u0012\u0008\u0008\u0002\u0010D\u001a\u00020\u0012\u0012\u0008\u0008\u0002\u0010E\u001a\u00020\u000c\u0012\u0008\u0008\u0002\u0010F\u001a\u00020\u0016\u0012\u0008\u0008\u0002\u0010G\u001a\u00020\u0016\u0012\u000e\u0008\u0002\u0010H\u001a\u0008\u0012\u0004\u0012\u00020\u000f0\u0014\u0012\n\u0008\u0002\u0010I\u001a\u0004\u0018\u00010%\u0012\u0008\u0008\u0002\u0010J\u001a\u00020\u000c\u0012\u0008\u0008\u0002\u0010K\u001a\u00020\u0012\u0012\u0008\u0008\u0002\u0010L\u001a\u00020\u0012\u0012\u0008\u0008\u0002\u0010M\u001a\u00020\u0012\u0012\u0008\u0008\u0002\u0010N\u001a\u00020\u0012\u0012\u0008\u0008\u0002\u0010O\u001a\u00020\u000c\u0012\n\u0008\u0002\u0010P\u001a\u0004\u0018\u00010-\u0012\u0008\u0008\u0002\u0010Q\u001a\u00020/\u0012\u0008\u0008\u0002\u0010R\u001a\u00020/\u0012\u000