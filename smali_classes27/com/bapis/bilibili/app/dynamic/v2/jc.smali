    d1 = {
        "\u0000\u00a5\u0001\n\u0002\u0018\u0002\n\u0002\u0010\u0000\n\u0000\n\u0002\u0018\u0002\n\u0000\n\u0002\u0018\u0002\n\u0000\n\u0002\u0018\u0002\n\u0002\u0008\u0003\n\u0002\u0010\u0011\n\u0002\u0018\u0002\n\u0002\u0008\u0003\n\u0002\u0010$\n\u0002\u0010\u000e\n\u0002\u0008\u0006\n\u0002\u0010 \n\u0002\u0008\u0002\n\u0002\u0018\u0002\n\u0002\u0008\u0003\n\u0002\u0010\u000b\n\u0000\n\u0002\u0010\u0008\n\u0000\n\u0002\u0010\t\n\u0002\u0008\u0003\n\u0002\u0018\u0002\n\u0002\u0008\u0002\n\u0002\u0018\u0002\n\u0002\u0008\u0002\n\u0002\u0018\u0002\n\u0000\n\u0002\u0018\u0002\n\u0000\n\u0002\u0018\u0002\n\u0002\u0008\u0004\n\u0002\u0018\u0002\n\u0002\u0008\u0002\n\u0002\u0018\u0002\n\u0000\n\u0002\u0018\u0002\n\u0002\u0008\u0003\n\u0002\u0018\u0002\n\u0003\u0008\u0088\u0001\n\u0002\u0018\u0002\n\u0002\u0008\u0006\u0008\u0087\u0008\u0018\u0000 \u00cb\u00012\u00020\u0001:\u0004\u00cc\u0001\u00cd\u0001B\u00f1\u0002\u0012\u0008\u0008\u0002\u0010A\u001a\u00020\u0011\u0012\u0008\u0008\u0002\u0010B\u001a\u00020\u0011\u0012\u0008\u0008\u0002\u0010C\u001a\u00020\u0011\u0012\u0008\u0008\u0002\u0010D\u001a\u00020\u0011\u0012\u0008\u0008\u0002\u0010E\u001a\u00020\u0011\u0012\u000e\u0008\u0002\u0010F\u001a\u0008\u0012\u0004\u0012\u00020\u000c0\u0018\u0012\u000e\u0008\u0002\u0010G\u001a\u0008\u0012\u0004\u0012\u00020\u000c0\u0018\u0012\u0008\u0008\u0002\u0010H\u001a\u00020\u001b\u0012\u0008\u0008\u0002\u0010I\u001a\u00020\u0011\u0012\u0008\u0008\u0002\u0010J\u001a\u00020\u0011\u0012\u0008\u0008\u0002\u0010K\u001a\u00020\u001f\u0012\u0008\u0008\u0002\u0010L\u001a\u00020!\u0012\u0008\u0008\u0002\u0010M\u001a\u00020#\u0012\u0008\u0008\u0002\u0010N\u001a\u00020#\u0012\u0008\u0008\u0002\u0010O\u001a\u00020\u0011\u0012\n\u0008\u0002\u0010P\u001a\u0004\u0018\u00010\'\u0012\u0008\u0008\u0002\u0010Q\u001a\u00020\u0011\u0012\n\u0008\u0002\u0010R\u001a\u0004\u0018\u00010*\u0012\u0008\u0008\u0002\u0010S\u001a\u00020\u0011\u0012\n\u0008\u0002\u0010T\u001a\u0004\u0018\u00010-\u0012\n\u0008\u0002\u0010U\u001a\u0004\u0018\u00010/\u0012\n\u0008\u0002\u0010V\u001a\u0004\u0018\u000101\u0012\u0008\u0008\u0002\u0010W\u001a\u00020\u001f\u0012\u0014\u0008\u0002\u0010X\u001a\u000e\u0012\u0004\u0012\u00020\u0011\u0012\u0004\u0012\u00020\u00110\u0010\u0012\u0008\u0008\u0002\u0010Y\u001a\u00020\u0011\u0012\n\u0008\u0002\u0010Z\u001a\u0004\u0018\u000106\u0012\u0008\u0008\u0002\u0010[\u001a\u00020\u001f\u0012\n\u0008\u0002\u0010\\\u001a\u0004\u0018\u000109\u0012\n\u0008\u0002\u0010]\u001a\u0004\u0018\u00010;\u0012\u0008\u0008\u0002\u0010^\u001a\u00020\u0011\u0012\u0008\u0008\u0002\u0010_\u001a\u00020\u0011\u0012\u0008\u0008\u0002\u0010`\u001a\u00020?\u00a2\u0006\u0006\u0008\u00c4\u0001\u0010\u00c5\u0001B\u00b5\u0003\u0008\u0011\u0012\u0007\u0010\u00c6\u0001\u001a\u00020!\u0012\u0007\u0010\u00c7\u0001\u001a\u00020!\u0012\n\u0008\u0001\u0010A\u001a\u0004\u0018\u00010\u0011\u0012\n\u0008\u0001\u0010B\u001a\u0004\u0018\u00010\u0011\u0012\n\u0008\u0001\u0010C\u001a\u0004\u0018\u00010\u0011\u0012\n\u0008\u0001\u0010D\u001a\u0004\u0018\u00010\u0011\u0012\n\u0008\u0001\u0010E\u001a\u0004\u0018\u00010\u0011\u0012\u0010\u0008\u0001\u0010F\u001a\n\u0012\u0004\u0012\u00020\u000c\u0018\u00010\u0018\u0012\u0010\u0008\u0001\u0010G\u001a\n\u0012\u0004\u0012\u00020\u000c\u0018\u00010\u0018\u0012\n\u0008\u0001\u0010H\u001a\u0004\u0018\u00010\u001b\u0012\n\u0008\u0001\u0010I\u001a\u0004\u0018\u00010\u0011\u0012\n\u0008\u0001\u0010J\u001a\u0004\u0018\u00010\u0011\u0012\u0008\u0008\u0001\u0010K\u001a\u00020\u001f\u0012\u0008\u0008\u0001\u0010L\u001a\u00020!\u0012\u0008\u0008\u0001\u0010M\u001a\u00020#\u0012\u0008\u0008\u0001\u0010N\u001a\u00020#\u0012\n\u0008\u0001\u0010O\u001a\u0004\u0018\u00010\u0011\u0012\n\u0008\u0001\u0010P\u001a\u0004\u0018\u00010\'\u0012\n\u0008\u0001\u0010Q\u001a\u0004\u0018\u00010\u0011\u0012\n\u0008\u0001\u0010R\u001a\u0004\u0018\u00010*\u0012\n\u0008\u0001\u0010S\u001a\u0004\u0018\u00010\u0011\u0012\n\u0008\u0001\u0010T\u001a\u0004\u0018\u00010-\u0012\n\u0008\u0001\u0010U\u001a\u0004\u0018\u00010/\u0012\n\u0008\u0001\u0010V\u001a\u0004\u0018\u000101\u0012\u0008\u0008\u0001\u0010W\u001a\u00020\u001f\u0012\u0016\u0008\u0001\u0010X\u001a\u0010\u0012\u0004\u0012\u00020\u0011\u0012\u0004\u0012\u00020\u0011\u0018\u00010\u0010\u0012\n\u0008\u0001\u0010Y\u001a\u0004\u0018\u00010\u0011\u0012\n\u0008\u0001\u0010Z\u001a\u0004\u0018\u000106\u0012\u0008\u0008\u0001\u0010[\u001a\u00020\u001f\u0012\n\u0008\u0001\u0010\\\u001a\u0004\u0018\u000109\u0012\n\u0008\u0001\u0010]\u001a\u0004\u0018\u00010;\u0012\n\u0008\u0001\u0010^\u001a\u0004\u0018\u00010\u0011\u0012\n\u0008\u0001\u0010_\u001a\u0004\u0018\u00010\u0011\u0012\n\u0008\u0001\u0010`\u001a\u0004\u0018\u00010?\u0012\n\u0010\u00c9\u0001\u001a\u0005\u0018\u00010\u00c8\u0001\u00a2\u0006\u0006\u0008\u00c4\u0001\u0010\u00ca\u0001J(\u0010\n\u001a\u00020\u00072\u0006\u0010\u0002\u001a\u00020\u00002\u0006\u0010\u0004\u001a\u00020\u00032\u0006\u0010\u0006\u001a\u00020\u0005H\u00c1\u0001\u00a2\u0006\u0004\u0008\u0008\u0010\tJ\u0013\u0010\r\u001a\u0008\u0012\u0004\u0012\u00020\u000c0\u000b\u00a2\u0006\u0004\u0008\r\u0010\u000eJ\u0015\u0010\u000f\u001a\u0008\u0012\u0004\u0012\u00020\u000c0\u000bH\u0007\u00a2\u0006\u0004\u0008\u000f\u0010\u000eJ\u0012\u0010\u0012\u001a\u000e\u0012\u0004\u0012\u00020\u0011\u0012\u0004\u0012\u00020\u00110\u0010J\t\u0010\u0013\u001a\u00020\u0011H\u00c6\u0003J\t\u0010\u0014\u001a\u00020\u0011H\u00c6\u0003J\t\u0010\u0015\u001a\u00020\u0011H\u00c6\u0003J\t\u0010\u0016\u001a\u00020\u0011H\u00c6\u0003J\t\u0010\u0017\u001a\u00020\u0011H\u00c6\u0003J\u000f\u0010\u0019\u001a\u0008\u0012\u0004\u0012\u00020\u000c0\u0018H\u00c6\u0003J\u000f\u0010\u001a\u001a\u0008\u0012\u0004\u0012\u00020\u000c0\u0018H\u00c6\u0003J\t\u0010\u001c\u001a\u00020\u001bH\u00c6\u0003J\t\u0010\u001d\u001a\u00020\u0011H\u00c6\u0003J\t\u0010\u001e\u001a\u00020\u0011H\u00c6\u0003J\t\u0010 \u001a\u00020\u001fH\u00c6\u0003J\t\u0010\"\u001a\u00020!H\u00c6\u0003J\t\u0010$\u001a\u00020#H\u00c6\u0003J\t\u0010%\u001a\u00020#H\u00c6\u0003J\t\u0010&\u001a\u00020\u0011H\u00c6\u0003J\u000b\u0010(\u001a\u0004\u0018\u00010\'H\u00c6\u0003J\t\u0010)\u001a\u00020\u0011H\u00c6\u0003J\u000b\u0010+\u001a\u0004\u0018\u00010*H\u00c6\u0003J\t\u0010,\u001a\u00020\u0011H\u00c6\u0003J\u000b\u0010.\u001a\u0004\u0018\u00010-H\u00c6\u0003J\u000b\u00100\u001a\u0004\u0018\u00010/H\u00c6\u0003J\u000b\u00102\u001a\u0004\u0018\u000101H\u00c6\u0003J\t\u00103\u001a\u00020\u001fH\u00c6\u0003J\u0015\u00104\u001a\u000e\u0012\u0004\u0012\u00020\u0011\u0012\u0004\u0012\u00020\u00110\u0010H\u00c6\u0003J\t\u00105\u001a\u00020\u0011H\u00c6\u0003J\u000b\u00107\u001a\u0004\u0018\u000106H\u00c6\u0003J\t\u00108\u001a\u00020\u001fH\u00c6\u0003J\u000b\u0010:\u001a\u0004\u0018\u000109H\u00c6\u0003J\u000b\u0010<\u001a\u0004\u0018\u00010;H\u00c6\u0003J\t\u0010=\u001a\u00020\u0011H\u00c6\u0003J\t\u0010>\u001a\u00020\u0011H\u00c6\u0003J\t\u0010@\u001a\u00020?H\u00c6\u0003J\u00f1\u0002\u0010a\u001a\u00020\u00002\u0008\u0008\u0002\u0010A\u001a\u00020\u00112\u0008\u0008\u0002\u0010B\u001a\u00020\u00112\u0008\u0008\u0002\u0010C\u001a\u00020\u00112\u0008\u0008\u0002\u0010D\u001a\u00020\u00112\u0008\u0008\u0002\u0010E\u001a\u00020\u00112\u000e\u0008\u0002\u0010F\u001a\u0008\u0012\u0004\u0012\u00020\u000c0\u00182\u000e\u0008\u0002\u0010G\u001a\u0008\u0012\u0004\u0012\u00020\u000c0\u00182\u0008\u0008\u0002\u0010H\u001a\u00020\u001b2\u0008\u0008\u0002\u0010I\u001a\u00020\u00112\u0008\u0008\u0002\u0010J\u001a\u00020\u00112\u0008\u0008\u0002\u0010K\u001a\u00020\u001f2\u0008\u0008\u0002\u0010L\u001a\u00020!2\u0008\u0008\u0002\u0010M\u001a\u00020#2\u0008\u0008\u0002\u0010N\u001a\u00020#2\u0008\u0008\u0002\u0010O\u001a\u00020\u00112\n\u0008\u0002\u0010P\u001a\u0004\u0018\u00010\'2\u0008\u0008\u0002\u0010Q\u001a\u00020\u00112\n\u0008\u0002\u0010R\u001a\u0004\u0018\u00010*2\u0008\u0008\u0002\u0010S\u001a\u00020\u00112\n\u0008\u0002\u0010T\u001a\u0004\u0018\u00010-2\n\u0008\u0002\u0010U\u001a\u0004\u0018\u00010/2\n\u0008\u0002\u0010V\u001a\u0004\u0018\u0001012\u0008\u0008\u0002\u0010W\u001a\u00020\u001f2\u0014\u0008\u0002\u0010X\u001a\u000e\u0012\u0004\u0012\u00020\u0011\u0012\u0004\u0012\u00020\u00110\u00102\u0008\u0008\u0002\u0010Y\u001a\u00020\u00112\n\u0008\u0002\u0010Z\u001a\u0004\u0018\u0001062\u0008\u0008\u0002\u0010[\u001a\u00020\u001f2\n\u0008\u0002\u0010\\\u001a\u0004\u0018\u0001092\n\u0008\u0002\u0010]\u001a\u0004\u0018\u00010;2\u0008\u0008\u0002\u0010^\u001a\u00020\u00112\u0008\u0008\u0002\u0010_\u001a\u00020\u00112\u0008\u0008\u0002\u0010`\u001a\u00020?H\u00c6\u0001J\t\u0010b\u001a\u00020\u0011H\u00d6\u0001J\t\u0010c\u001a\u00020!H\u00d6\u0001J\u0013\u0010e\u001a\u00020\u001f2\u0008\u0010d\u001a\u0004\u0018\u00010\u0001H\u00d6\u0003R \u0010A\u001a\u00020\u00118\u0006X\u0087\u0004\u00a2\u0006\u0012\n\u0004\u0008A\u0010f\u0012\u0004\u0008i\u0010j\u001a\u0004\u0008g\u0010hR \u0010B\u001a\u00020\u00118\u0006X\u0087\u0004\u00a2\u0006\u0012\n\u0004\u0008B\u0010f\u0012\u0004\u0008l\u0010j\u001a\u0004\u0008k\u0010hR \u0010C\u001a\u00020\u00118\u0006X\u0087\u0004\u00a2\u0006\u0012\n\u0004\u0008C\u0010f\u0012\u0004\u0008n\u0010j\u001a\u0004\u0008m\u0010hR \u0010D\u001a\u00020\u00118\u0006X\u0087\u0004\u00a2\u0006\u0012\n\u0004\u0008D\u0010f\u0012\u0004\u0008p\u0010j\u001a\u0004\u0008o\u0010hR \u0010E\u001a\u00020\u00118\u0006X\u0087\u0004\u00a2\u0006\u0012\n\u0004\u0008E\u0010f\u0012\u0004\u0008r\u0010j\u001a\u0004\u0008q\u0010hR&\u0010F\u001a\u0008\u0012\u0004\u0012\u00020\u000c0\u00188\u0006X\u0087\u0004\u00a2\u0006\u0012\n\u0004\u0008F\u0010s\u0012\u0004\u0008v\u0010j\u001a\u0004\u0008t\u0010uR&\u0010G\u001a\u0008\u0012\u0004\u0012\u00020\u000c0\u00188\u0006X\u0087\u0004\u00a2\u0006\u0012\n\u0004\u0008G\u0010s\u0012\u0004\u0008x\u0010j\u001a\u0004\u0008w\u0010uR \u0010H\u001a\u00020\u001b8\u0006X\u0087\u0004\u00a2\u0006\u0012\n\u0004\u0008H\u0010y\u0012\u0004\u0008|\u0010j\u001a\u0004\u0008z\u0010{R \u0010I\u001a\u00020\u00118\u0006X\u0087\u0004\u00a2\u0006\u0012\n\u0004\u0008I\u0010f\u0012\