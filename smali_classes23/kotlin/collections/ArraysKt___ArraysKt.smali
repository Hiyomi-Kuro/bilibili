    d1 = {
        "\u0000\u008c\u0002\n\u0000\n\u0002\u0010\u0011\n\u0000\n\u0002\u0010\u000b\n\u0002\u0008\u0002\n\u0002\u0010\u0012\n\u0002\u0010\u0005\n\u0000\n\u0002\u0010\u0017\n\u0002\u0010\n\n\u0000\n\u0002\u0010\u0015\n\u0002\u0010\u0008\n\u0000\n\u0002\u0010\u0016\n\u0002\u0010\t\n\u0000\n\u0002\u0010\u0019\n\u0002\u0010\u000c\n\u0002\u0008\u0005\n\u0002\u0010\u0014\n\u0002\u0010\u0007\n\u0002\u0008\u000c\n\u0002\u0010\u0018\n\u0002\u0008\u0015\n\u0002\u0010 \n\u0002\u0008\u0003\n\u0002\u0010\u0000\n\u0002\u0008\u0002\n\u0002\u0010\u001f\n\u0002\u0008\u0004\n\u0002\u0018\u0002\n\u0002\u0008\u0004\n\u0002\u0018\u0002\n\u0002\u0008\u0003\n\u0002\u0018\u0002\n\u0002\u0008\u0003\n\u0002\u0010\u000f\n\u0002\u0008\u0004\n\u0002\u0018\u0002\n\u0002\u0018\u0002\n\u0002\u0008\u000c\n\u0002\u0018\u0002\n\u0002\u0018\u0002\n\u0002\u0008\u0008\n\u0002\u0010\u0013\n\u0002\u0010\u0006\n\u0002\u0008\u0003\n\u0002\u0010!\n\u0002\u0008\t\n\u0002\u0010\"\n\u0002\u0008\u0004\n\u0002\u0018\u0002\n\u0002\u0008\u0003\n\u0002\u0010\u001c\n\u0002\u0018\u0002\n\u0002\u0008\u0004\n\u0002\u0010#\n\u0002\u0008\t\n\u0002\u0018\u0002\n\u0002\u0008\u0004\n\u0002\u0018\u0002\n\u0002\u0018\u0002\n\u0002\u0008\u0002\n\u0002\u0010\r\n\u0002\u0008\u000b\n\u0002\u0010\u000e\n\u0002\u0008\u0005\n\u0002\u0018\u0002\n\u0002\u0008\u0018\u001a*\u0010\u0004\u001a\u00020\u0003\"\u0004\u0008\u0000\u0010\u0000*\n\u0012\u0006\u0008\u0001\u0012\u00028\u00000\u00012\u0006\u0010\u0002\u001a\u00028\u0000H\u0086\u0002\u00a2\u0006\u0004\u0008\u0004\u0010\u0005\u001a\u0015\u0010\u0008\u001a\u00020\u0003*\u00020\u00062\u0006\u0010\u0002\u001a\u00020\u0007H\u0086\u0002\u001a\u0015\u0010\u000b\u001a\u00020\u0003*\u00020\t2\u0006\u0010\u0002\u001a\u00020\nH\u0086\u0002\u001a\u0015\u0010\u000e\u001a\u00020\u0003*\u00020\u000c2\u0006\u0010\u0002\u001a\u00020\rH\u0086\u0002\u001a\u0015\u0010\u0011\u001a\u00020\u0003*\u00020\u000f2\u0006\u0010\u0002\u001a\u00020\u0010H\u0086\u0002\u001a\u0015\u0010\u0014\u001a\u00020\u0003*\u00020\u00122\u0006\u0010\u0002\u001a\u00020\u0013H\u0086\u0002\u001a\u001f\u0010\u0015\u001a\u00028\u0000\"\u0004\u0008\u0000\u0010\u0000*\n\u0012\u0006\u0008\u0001\u0012\u00028\u00000\u0001\u00a2\u0006\u0004\u0008\u0015\u0010\u0016\u001a\n\u0010\u0017\u001a\u00020\r*\u00020\u000c\u001a\n\u0010\u0018\u001a\u00020\u0010*\u00020\u000f\u001a\n\u0010\u001b\u001a\u00020\u001a*\u00020\u0019\u001a\n\u0010\u001c\u001a\u00020\u0013*\u00020\u0012\u001a!\u0010\u001d\u001a\u0004\u0018\u00018\u0000\"\u0004\u0008\u0000\u0010\u0000*\n\u0012\u0006\u0008\u0001\u0012\u00028\u00000\u0001\u00a2\u0006\u0004\u0008\u001d\u0010\u0016\u001a)\u0010\u001f\u001a\u0004\u0018\u00018\u0000\"\u0004\u0008\u0000\u0010\u0000*\n\u0012\u0006\u0008\u0001\u0012\u00028\u00000\u00012\u0006\u0010\u001e\u001a\u00020\r\u00a2\u0006\u0004\u0008\u001f\u0010 \u001a\u001b\u0010!\u001a\u0004\u0018\u00010\u0007*\u00020\u00062\u0006\u0010\u001e\u001a\u00020\r\u00a2\u0006\u0004\u0008!\u0010\"\u001a\u001b\u0010#\u001a\u0004\u0018\u00010\r*\u00020\u000c2\u0006\u0010\u001e\u001a\u00020\r\u00a2\u0006\u0004\u0008#\u0010$\u001a\u001b\u0010%\u001a\u0004\u0018\u00010\u001a*\u00020\u00192\u0006\u0010\u001e\u001a\u00020\r\u00a2\u0006\u0004\u0008%\u0010&\u001a\u001b\u0010(\u001a\u0004\u0018\u00010\u0003*\u00020\'2\u0006\u0010\u001e\u001a\u00020\r\u00a2\u0006\u0004\u0008(\u0010)\u001a\'\u0010*\u001a\u00020\r\"\u0004\u0008\u0000\u0010\u0000*\n\u0012\u0006\u0008\u0001\u0012\u00028\u00000\u00012\u0006\u0010\u0002\u001a\u00028\u0000\u00a2\u0006\u0004\u0008*\u0010+\u001a\u0012\u0010,\u001a\u00020\r*\u00020\u00062\u0006\u0010\u0002\u001a\u00020\u0007\u001a\u0012\u0010-\u001a\u00020\r*\u00020\t2\u0006\u0010\u0002\u001a\u00020\n\u001a\u0012\u0010.\u001a\u00020\r*\u00020\u000c2\u0006\u0010\u0002\u001a\u00020\r\u001a\u0012\u0010/\u001a\u00020\r*\u00020\u000f2\u0006\u0010\u0002\u001a\u00020\u0010\u001a\u0012\u00100\u001a\u00020\r*\u00020\u00122\u0006\u0010\u0002\u001a\u00020\u0013\u001a\u001f\u00101\u001a\u00028\u0000\"\u0004\u0008\u0000\u0010\u0000*\n\u0012\u0006\u0008\u0001\u0012\u00028\u00000\u0001\u00a2\u0006\u0004\u00081\u0010\u0016\u001a\n\u00102\u001a\u00020\r*\u00020\u000c\u001a\n\u00103\u001a\u00020\u001a*\u00020\u0019\u001a\n\u00104\u001a\u00020\u0013*\u00020\u0012\u001a\'\u00105\u001a\u00020\r\"\u0004\u0008\u0000\u0010\u0000*\n\u0012\u0006\u0008\u0001\u0012\u00028\u00000\u00012\u0006\u0010\u0002\u001a\u00028\u0000\u00a2\u0006\u0004\u00085\u0010+\u001a\u0012\u00106\u001a\u00020\r*\u00020\u00062\u0006\u0010\u0002\u001a\u00020\u0007\u001a\u0012\u00107\u001a\u00020\r*\u00020\u000c2\u0006\u0010\u0002\u001a\u00020\r\u001a!\u00108\u001a\u0004\u0018\u00018\u0000\"\u0004\u0008\u0000\u0010\u0000*\n\u0012\u0006\u0008\u0001\u0012\u00028\u00000\u0001\u00a2\u0006\u0004\u00088\u0010\u0016\u001a\u001f\u00109\u001a\u00028\u0000\"\u0004\u0008\u0000\u0010\u0000*\n\u0012\u0006\u0008\u0001\u0012\u00028\u00000\u0001\u00a2\u0006\u0004\u00089\u0010\u0016\u001a\n\u0010:\u001a\u00020\u0013*\u00020\u0012\u001a!\u0010;\u001a\u0004\u0018\u00018\u0000\"\u0004\u0008\u0000\u0010\u0000*\n\u0012\u0006\u0008\u0001\u0012\u00028\u00000\u0001\u00a2\u0006\u0004\u0008;\u0010\u0016\u001a-\u0010>\u001a\u0008\u0012\u0004\u0012\u00028\u00000=\"\u0004\u0008\u0000\u0010\u0000*\n\u0012\u0006\u0008\u0001\u0012\u00028\u00000\u00012\u0006\u0010<\u001a\u00020\r\u00a2\u0006\u0004\u0008>\u0010?\u001a\u0018\u0010@\u001a\u0008\u0012\u0004\u0012\u00020\u001a0=*\u00020\u00192\u0006\u0010<\u001a\u00020\r\u001a+\u0010B\u001a\u0008\u0012\u0004\u0012\u00028\u00000=\"\u0008\u0008\u0000\u0010\u0000*\u00020A*\u000c\u0012\u0008\u0008\u0001\u0012\u0004\u0018\u00018\u00000\u0001\u00a2\u0006\u0004\u0008B\u0010C\u001a?\u0010G\u001a\u00028\u0000\"\u0010\u0008\u0000\u0010E*\n\u0012\u0006\u0008\u0000\u0012\u00028\u00010D\"\u0008\u0008\u0001\u0010\u0000*\u00020A*\u000c\u0012\u0008\u0008\u0001\u0012\u0004\u0018\u00018\u00010\u00012\u0006\u0010F\u001a\u00028\u0000\u00a2\u0006\u0004\u0008G\u0010H\u001a\u0012\u0010K\u001a\u00020\u0006*\u00020\u00062\u0006\u0010J\u001a\u00020I\u001a-\u0010L\u001a\u0008\u0012\u0004\u0012\u00028\u00000=\"\u0004\u0008\u0000\u0010\u0000*\n\u0012\u0006\u0008\u0001\u0012\u00028\u00000\u00012\u0006\u0010<\u001a\u00020\r\u00a2\u0006\u0004\u0008L\u0010?\u001a\u0018\u0010M\u001a\u0008\u0012\u0004\u0012\u00020\u001a0=*\u00020\u00192\u0006\u0010<\u001a\u00020\r\u001a\u001d\u0010O\u001a\u00020N\"\u0004\u0008\u0000\u0010\u0000*\u0008\u0012\u0004\u0012\u00028\u00000\u0001\u00a2\u0006\u0004\u0008O\u0010P\u001a\u001f\u0010Q\u001a\u00020N\"\u0004\u0008\u0000\u0010\u0000*\u0008\u0012\u0004\u0012\u00028\u00000\u0001H\u0007\u00a2\u0006\u0004\u0008Q\u0010P\u001a\'\u0010T\u001a\u00020N\"\u0004\u0008\u0000\u0010\u0000*\u0008\u0012\u0004\u0012\u00028\u00000\u00012\u0006\u0010S\u001a\u00020RH\u0007\u00a2\u0006\u0004\u0008T\u0010U\u001a/\u0010W\u001a\u0008\u0012\u0004\u0012\u00028\u00000=\"\u000e\u0008\u0000\u0010\u0000*\u0008\u0012\u0004\u0012\u00028\u00000V*\n\u0012\u0006\u0008\u0001\u0012\u00028\u00000\u0001\u00a2\u0006\u0004\u0008W\u0010X\u001a-\u0010Y\u001a\u0008\u0012\u0004\u0012\u00028\u00000\u0001\"\u000e\u0008\u0000\u0010\u0000*\u0008\u0012\u0004\u0012\u00028\u00000V*\u0008\u0012\u0004\u0012\u00028\u00000\u0001\u00a2\u0006\u0004\u0008Y\u0010Z\u001aC\u0010^\u001a\n\u0012\u0006\u0008\u0001\u0012\u00028\u00000\u0001\"\u0004\u0008\u0000\u0010\u0000*\n\u0012\u0006\u0008\u0001\u0012\u00028\u00000\u00012\u001a\u0010]\u001a\u0016\u0012\u0006\u0008\u0000\u0012\u00028\u00000[j\n\u0012\u0006\u0008\u0000\u0012\u00028\u0000`\\\u00a2\u0006\u0004\u0008^\u0010_\u001aA\u0010`\u001a\u0008\u0012\u0004\u0012\u00028\u00000=\"\u0004\u0008\u0000\u0010\u0000*\n\u0012\u0006\u0008\u0001\u0012\u00028\u00000\u00012\u001a\u0010]\u001a\u0016\u0012\u0006\u0008\u0000\u0012\u00028\u00000[j\n\u0012\u0006\u0008\u0000\u0012\u00028\u0000`\\\u00a2\u0006\u0004\u0008`\u0010a\u001a\u0019\u0010b\u001a\u00020\u0019*\n\u0012\u0006\u0008\u0001\u0012\u00020\u001a0\u0001\u00a2\u0006\u0004\u0008b\u0010c\u001a9\u0010d\u001a\u00028\u0001\"\u0004\u0008\u0000\u0010\u0000\"\u0010\u0008\u0001\u0010E*\n\u0012\u0006\u0008\u0000\u0012\u00028\u00000D*\n\u0012\u0006\u0008\u0001\u0012\u00028\u00000\u00012\u0006\u0010F\u001a\u00028\u0001\u00a2\u0006\u0004\u0008d\u0010H\u001a+\u0010e\u001a\u00028\u0000\"\u0010\u0008\u0000\u0010E*\n\u0012\u0006\u0008\u0000\u0012\u00020\r0D*\u00020\u000c2\u0006\u0010F\u001a\u00028\u0000\u00a2\u0006\u0004\u0008e\u0010f\u001a+\u0010g\u001a\u00028\u0000\"\u0010\u0008\u0000\u0010E*\n\u0012\u0006\u0008\u0000\u0012\u00020\u00100D*\u00020\u000f2\u0006\u0010F\u001a\u00028\u0000\u00a2\u0006\u0004\u0008g\u0010h\u001a/\u0010k\u001a\u0012\u0012\u0004\u0012\u00028\u00000ij\u0008\u0012\u0004\u0012\u00028\u0000`j\"\u0004\u0008\u0000\u0010\u0000*\n\u0012\u0006\u0008\u0001\u0012\u00028\u00000\u0001\u00a2\u0006\u0004\u0008k\u0010l\u001a%\u0010m\u001a\u0008\u0012\u0004\u0012\u00028\u00000=\"\u0004\u0008\u0000\u0010\u0000*\n\u0012\u0006\u0008\u0001\u0012\u00028\u00000\u0001\u00a2\u0006\u0004\u0008m\u0010C\u001a\u0010\u0010n\u001a\u0008\u0012\u0004\u0012\u00020\u00070=*\u00020\u0006\u001a\u0010\u0010o\u001a\u0008\u0012\u0004\u0012\u00020\n0=*\u00020\t\u001a\u0010\u0010p\u001a\u0008\u0012\u0004\u0012\u00020\r0=*\u00020\u000c\u001a\u0010\u0010q\u001a\u0008\u0012\u0004\u0012\u00020\u00100=*\u00020\u000f\u001a\u0010\u0010r\u001a\u0008\u0012\u0004\u0012\u00020\u001a0=*\u00020\u0019\u001a\u0010\u0010u\u001a\u0008\u0012\u0004\u0012\u00020t0=*\u00020s\u001a\u0010\u0010v\u001a\u0008\u0012\u0004\u0012\u00020\u00030=*\u00020\'\u001a\u0010\u0010w\u001a\u0008\u0012\u0004\u0012\u00020\u00130=*\u00020\u0012\u001a%\u0010y\u001a\u0008\u0012\u0004\u0012\u00028\u00000x\"\u0004\u0008\u0000\u0010\u0000*\n\u0012\u0006\u0008\u0001\u0012\u00028\u00000\u0001\u00a2\u0006\u0004\u0008y\u0010C\u001a\u0010\u0010z\u001a\u0008\u0012\u0004\u0012\u00020\u00070x*\u00020\u0006\u001a\u0010\u0010{\u001a\u0008\u0012\u0004\u0012\u00020\n0x*\u00020\t\u001a\u0010\u0010|\u001a\u0008\u0012\u0004\u0012\u00020\r0x*\u00020\u000c\u001a\u0010\u0010}\u001a\u0008\u0012\u0004