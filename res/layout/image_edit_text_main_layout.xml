<?xml version="1.0" encoding="utf-8"?>
<FrameLayout android:background="@android:color/background_dark" android:clickable="true" android:layout_width="match_parent" android:layout_height="match_parent"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <FrameLayout android:id="@id/image_show" android:background="@android:color/transparent" android:paddingTop="@dimen/image_edit_base_top" android:paddingBottom="@dimen/image_edit_base_bottom" android:layout_width="match_parent" android:layout_height="match_parent">
        <com.bilibili.bplus.imageeditor.view.BiliCropView android:id="@id/text_edit_item_view" android:layout_width="match_parent" android:layout_height="match_parent" />
        <com.bilibili.bplus.imageeditor.view.DrawRect android:id="@id/text_edit_drawrect" android:layout_width="match_parent" android:layout_height="match_parent" />
    </FrameLayout>
    <LinearLayout android:layout_gravity="bottom" android:orientation="vertical" android:id="@id/image_ctrl" android:background="@color/image_edit_upper_bg_color" android:layout_width="match_parent" android:layout_height="@dimen/image_edit_text_controller_height">
        <LinearLayout android:layout_gravity="center" android:orientation="horizontal" android:id="@id/text_edit_controller_alpha" android:layout_width="match_parent" android:layout_height="@dimen/image_edit_text_controller_alpha_height" android:layout_marginLeft="@dimen/image_edit_text_alpha_margin_left" android:layout_marginRight="@dimen/image_edit_text_alpha_margin_right">
            <TextView android:textSize="@dimen/image_edit_text_alpha_text_size" android:textColor="@color/image_edit_text_alpha_text_color" android:layout_gravity="center_vertical" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/image_edit_text_alpha_text_string" />
            <SeekBar android:layout_gravity="center_vertical" android:id="@id/text_edit_controller_alpha_seekbar" android:layout_width="0.0dp" android:layout_height="wrap_content" android:maxHeight="2.0dp" android:progressDrawable="@drawable/image_edit_seekbar_used" android:minHeight="2.0dp" android:thumb="@drawable/image_edit_seekbar_thumb_used" android:layout_weight="1.0" />
        </LinearLayout>
        <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="@dimen/image_edit_text_bc_main_height">
