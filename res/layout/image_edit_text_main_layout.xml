            <androidx.recyclerview.widget.RecyclerView android:layout_gravity="center" android:id="@id/text_edit_controller_color_list" android:layout_width="match_parent" android:layout_height="@dimen/image_edit_text_color_list_height" android:layout_marginLeft="@dimen/image_edit_text_color_list_margin_left" android:layout_marginRight="@dimen/image_edit_text_color_list_margin_right" android:overScrollMode="never" />
        </LinearLayout>
        <include layout="@layout/image_edit_base_sure_cancel_layout" />
    </LinearLayout>
</FrameLayout>
