<?xml version="1.0" encoding="utf-8"?>
<LinearLayout android:orientation="vertical" android:layout_width="wrap_content" android:layout_height="wrap_content"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <RelativeLayout android:id="@id/container" android:background="@drawable/shape_bg_tips_popup" android:paddingLeft="@dimen/image_edit_tips_container_padding_left" android:paddingRight="@dimen/image_edit_tips_container_padding_right" android:layout_width="wrap_content" android:layout_height="@dimen/image_edit_tips_container_height">
        <TextView android:textSize="@dimen/image_edit_tips_text_size" android:textColor="@color/Wh0_u" android:ellipsize="end" android:id="@id/message" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:layout_centerVertical="true" />
        <ImageView android:id="@id/close" android:layout_width="@dimen/image_edit_tips_close_icon_width" android:layout_height="match_parent" android:layout_marginLeft="@dimen/image_edit_tips_close_icon_margin_left" android:src="@drawable/img_painting_media_cancel" android:layout_toRightOf="@id/message" android:layout_centerVertical="true" />
    </RelativeLayout>
    <ImageView android:id="@id/triangle" android:paddingTop="1.0dp" android:layout_width="@dimen/image_edit_tips_triangle_width" android:layout_height="@dimen/image_edit_tips_triangle_height" android:src="@drawable/ic_menu_arrow" android:tint="@color/pink" android:rotation="180.0" />
</LinearLayout>
