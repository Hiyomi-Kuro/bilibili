<?xml version="1.0" encoding="utf-8"?>
<FrameLayout android:id="@id/picture_edit_main" android:background="@android:color/background_dark" android:layout_width="match_parent" android:layout_height="match_parent"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <FrameLayout android:id="@id/picture_container" android:background="@android:color/transparent" android:paddingTop="@dimen/image_edit_base_top" android:paddingBottom="@dimen/image_edit_base_bottom" android:layout_width="match_parent" android:layout_height="match_parent">
        <com.bilibili.bplus.imageeditor.view.widget.ImageShowViewPager android:id="@id/image_edit_pager" android:layout_width="match_parent" android:layout_height="match_parent" />
