    </FrameLayout>
    <LinearLayout android:layout_gravity="bottom" android:orientation="horizontal" android:id="@id/picture_controller" android:background="@android:color/transparent" android:visibility="visible" android:layout_width="match_parent" android:layout_height="@dimen/image_edit_base_bottom">
        <ImageView android:id="@id/picture_filter" android:layout_width="0.0dp" android:layout_height="match_parent" android:src="@drawable/image_edit_main_filter" android:scaleType="center" android:layout_weight="1.0" />
        <ImageView android:id="@id/picture_editer" android:layout_width="0.0dp" android:layout_height="match_parent" android:src="@drawable/image_edit_main_edit" android:scaleType="center" android:layout_weight="1.0" />
        <ImageView android:id="@id/picture_textadder" android:layout_width="0.0dp" android:layout_height="match_parent" android:src="@drawable/image_edit_main_text" android:scaleType="center" android:layout_weight="1.0" />
        <ImageView android:id="@id/picture_label" android:layout_width="0.0dp" android:layout_height="match_parent" android:src="@drawable/image_edit_main_label" android:scaleType="center" android:layout_weight="1.0" />
    </LinearLayout>
    <FrameLayout android:id="@id/fragment_container" android:layout_width="match_parent" android:layout_height="match_parent" />
