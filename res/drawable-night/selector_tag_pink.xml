<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <corners android:radius="@dimen/corner_radius" />
            <padding android:left="@dimen/item_half_spacing" android:top="4.0dp" android:right="@dimen/item_half_spacing" android:bottom="4.0dp" />
            <solid android:color="@color/pink_dark" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape>
            <corners android:radius="@dimen/corner_radius" />
            <stroke android:width="1.0dp" android:color="@color/pink_dark" />
            <padding android:left="@dimen/item_half_spacing" android:top="4.0dp" android:right="@dimen/item_half_spacing" android:bottom="4.0dp" />
            <solid android:color="@color/gray_dark_alpha26" />
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="@dimen/corner_radius" />
            <stroke android:width="1.0px" android:color="@color/gray_dark_alpha26" />
            <padding android:left="@dimen/item_half_spacing" android:top="4.0dp" android:right="@dimen/item_half_spacing" android:bottom="4.0dp" />
            <solid android:color="@color/gray_dark_alpha26" />
        </shape>
    </item>
</selector>
