<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <corners android:radius="@dimen/update_corner_radius_medium" />
            <solid android:color="@color/update_night" />
            <stroke android:width="0.5dp" android:color="#4e4e4e" />
        </shape>
    </item>
    <item>
        <shape>
            <stroke android:width="0.5dp" android:color="#4e4e4e" />
            <corners android:radius="@dimen/update_corner_radius_medium" />
            <solid android:color="#191919" />
        </shape>
    </item>
</selector>
