<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="false">
        <shape>
            <stroke android:width="1.0dp" android:color="#3dffffff" />
            <solid android:color="#14ffffff" />
            <corners android:radius="100.0dp" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape>
            <stroke android:width="0.5dp" android:color="#ff4785" />
            <solid android:color="#1eff4785" />
            <corners android:radius="100.0dp" />
        </shape>
    </item>
</selector>
