<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="false">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="4.0dp" />
                    <solid android:color="#0fffffff" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_selected="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#26ff6699" />
                    <corners android:radius="4.0dp" />
                    <stroke android:width="0.5dp" android:color="#ff6699" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="4.0dp" />
                    <solid android:color="#0fffffff" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
