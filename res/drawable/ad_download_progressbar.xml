<?xml version="1.0" encoding="utf-8"?>
<layer-list
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <solid android:color="@color/ad_download_process_background" />
            <corners android:topRightRadius="4.0dp" android:bottomRightRadius="4.0dp" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <scale android:scaleWidth="100%">
            <shape>
                <corners android:topRightRadius="4.0dp" android:bottomRightRadius="4.0dp" />
                <solid android:color="@color/theme_color_secondary" />
            </shape>
        </scale>
    </item>
</layer-list>
