<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape>
            <corners android:radius="24.0dp" />
            <stroke android:width="1.0dp" android:color="@color/shopping_goods_tab_select_color" />
        </shape>
    </item>
    <item android:state_checked="true">
        <shape>
            <corners android:radius="24.0dp" />
            <stroke android:width="1.0dp" android:color="@color/shopping_goods_tab_select_color" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <corners android:radius="24.0dp" />
            <stroke android:width="1.0dp" android:color="@color/shopping_goods_tab_select_color" />
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="24.0dp" />
            <stroke android:width="1.0dp" android:color="@color/shopping_goods_tab_stroke_unselect_color" />
        </shape>
    </item>
</selector>
