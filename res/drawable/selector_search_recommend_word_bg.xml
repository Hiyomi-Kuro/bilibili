<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="15.0dp" />
            <size android:height="30.0dp" />
            <solid android:color="@android:color/transparent" />
            <stroke android:width="0.5dp" android:color="@color/theme_color_secondary" />
            <padding android:left="16.0dp" android:right="16.0dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="15.0dp" />
            <size android:height="30.0dp" />
            <solid android:color="@android:color/transparent" />
            <stroke android:width="0.5dp" android:color="@color/Ga4" />
            <padding android:left="16.0dp" android:right="16.0dp" />
        </shape>
    </item>
</selector>
