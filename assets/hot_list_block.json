{
  "layout_width": "match_parent",
  "layout_height": "match_parent",
  "package": "tv.danmaku.bili",
  "background": "@drawable/op_card_background",
  "id": "container",
  "type": "constraint",
  "child": [
    {
      "layout_width": "104dp",
      "layout_height": "wrap_content",
      "textSize": "12dp",
      "layout_constraintTop_toTopOf": "parent",
      "type": "text",
      "textColor": "@color/Ga10_u",
      "layout_marginTop": "52dp",
      "layout_constraintStart_toEndOf": "block_left",
      "includeFontPadding": "false",
      "gravity": "center_horizontal",
      "maxLines": "1",
      "id": "tv_block_title_1",
      "text": "@string/widget_hot_list_not_agree_button"
    },
    {
      "ellipsize": "end",
      "layout_width": "104dp",
      "layout_height": "wrap_content",
      "textSize": "12dp",
      "layout_marginEnd": "28dp",
      "type": "text",
      "textColor": "@color/Ga10_u",
      "layout_marginTop": "2dp",
      "layout_constraintStart_toEndOf": "block_left",
      "includeFontPadding": "false",
      "layout_constraintTop_toBottomOf": "tv_block_title_1",
      "gravity": "center_horizontal",
      "maxLines": "1",
      "id": "tv_block_title_2",
      "text": "@string/widget_hot_list_not_agree_title_2"
    },
    {
      "layout_constraintEnd_toEndOf": "parent",
      "layout_width": "104dp",
      "layout_height": "30dp",
      "textSize": "12dp",
      "type": "text",
      "textColor": "@color/Wh0_u",
      "layout_marginTop": "9dp",
      "layout_constraintStart_toEndOf": "block_left",
      "layout_constraintTop_toBottomOf": "tv_block_title_2",
      "background": "@drawable/bili_app_op_widget_block_button_background",
      "gravity": "center",
      "text": "@string/widget_hot_list_not_agree_button",
      "lines": "1",
      "layout_constraintHorizontal_bias": "0"
    },
    {
      "layout_width": "38dp",
      "layout_height": "wrap_content",
      "src": "@drawable/ic_widget_brand",
      "layout_marginStart": "16dp",
      "id": "brand",
      "layout_gravity": "center_vertical",
      "layout_constraintTop_toTopOf": "parent",
      "type": "image",
      "layout_constraintStart_toStartOf": "parent",
      "layout_marginTop": "17dp"
    },
    {
      "layout_constraintWidth_percent": "0.6",
      "layout_constraintEnd_toEndOf": "parent",
      "layout_width": "0dp",
      "layout_height": "0dp",
      "src": "@drawable/ic_widget_block_left",
      "layout_constraintTop_toTopOf": "parent",
      "type": "image",
      "layout_constraintStart_toStartOf": "parent",
      "layout_marginTop": "28dp",
      "layout_constraintBottom_toBottomOf": "parent",
      "scaleType": "fitCenter",
      "id": "block_left",
      "layout_constraintHorizontal_bias": "0"
    }
  ]
}